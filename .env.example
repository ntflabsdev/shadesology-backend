# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
DATABASE_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/shadesology
# MONGODB_URI remains supported for existing deployments; use DATABASE_URI for new setup.
MONGODB_URI=
DB_NAME=shadesology
PAYLOAD_SECRET=replace_with_a_random_secret_at_least_32_characters
PAYLOAD_REST_URL=http://localhost:3000/api
PAYLOAD_COOKIE_NAME=payload-token
# Keep mongoose until legacy content has been reviewed/migrated; switch to payload for cutover.
EDITORIAL_CONTENT_SOURCE=mongoose
# Set only for an approved one-time CMS globals import; never reuse production passwords in local env.
PAYLOAD_MIGRATION_EMAIL=
PAYLOAD_MIGRATION_PASSWORD=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000
# Exact number of trusted reverse-proxy hops; keep 0 when clients connect directly
TRUST_PROXY_HOPS=0

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_long_random_secret

# ─── Redis (BullMQ background jobs) ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Set REDIS_ENABLED=false in local dev if Redis is not installed yet.
# Set to true (or remove the line entirely) once Redis is running.
# When false: queues become no-ops and local tests/development use in-memory rate limiting.
# In production: always set REDIS_ENABLED=true (or omit — defaults to true).
REDIS_ENABLED=true

# ─── AWS (shared credentials for S3 + SES) ────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_with_iam_access_key
AWS_SECRET_ACCESS_KEY=replace_with_iam_secret_key

# ─── S3 — Public bucket (CMS media, product images) ───────────────────────────
# Block Public Access must be OFF on this bucket
S3_BUCKET_PUBLIC=shadesology-media-public
S3_PUBLIC_BASE_URL=https://shadesology-media-public.s3.us-east-1.amazonaws.com

# ─── S3 — Private bucket (customer photos, drawings, gated docs, quote PDFs) ──
# Block Public Access must be ON on this bucket — files served via signed URLs only
S3_BUCKET_PRIVATE=shadesology-private-docs

# Signed URL expiry in seconds (default 3600 = 1 hour)
S3_SIGNED_URL_EXPIRES=3600

# ─── Amazon SES (transactional / operational email) ───────────────────────────
# Covers: order confirmations, status updates, quote status, password reset,
#         autoresponders, lead notifications, onboarding sequences, review requests,
#         maintenance reminders, internal alerts.
# NEVER use for marketing/newsletter — those go through HubSpot.
SES_FROM_EMAIL=noreply@shadesology.com
SES_REPLY_TO=support@shadesology.com
SES_CONFIGURATION_SET=shadesology-transactional
# sandbox = only sends to verified addresses; live = full send
SES_MODE=sandbox

# ─── HubSpot (CRM + marketing email) ──────────────────────────────────────────
# Covers: contacts, deals, lead sync, abandoned-cart/quote flows, campaigns,
#         welcome emails, post-purchase marketing flows, newsletter.
# NEVER send transactional/operational email through HubSpot.
# sandbox = uses only the developer test account; live = production portal.
# Never populate sandbox credentials with production credentials.
HUBSPOT_MODE=sandbox
HUBSPOT_SANDBOX_PRIVATE_APP_TOKEN=replace_with_sandbox_private_app_token
HUBSPOT_SANDBOX_PORTAL_ID=replace_with_sandbox_portal_id
HUBSPOT_LIVE_PRIVATE_APP_TOKEN=replace_with_live_private_app_token
HUBSPOT_LIVE_PORTAL_ID=replace_with_live_portal_id
HUBSPOT_WEBHOOK_SECRET=replace_with_hubspot_webhook_secret
HUBSPOT_COMMERCIAL_PIPELINE_ID=
HUBSPOT_COMMERCIAL_STAGE_ID=
HUBSPOT_WEBHOOK_PUBLIC_URL=https://api.shadesology.com/api/webhooks/hubspot
HUBSPOT_QUOTES_PIPELINE_ID=
HUBSPOT_QUOTES_STAGE_ID=
HUBSPOT_ORDERS_PIPELINE_ID=
HUBSPOT_ORDERS_STAGE_ID=
HUBSPOT_MARKETING_SUBSCRIPTION_ID=
CRM_ALERT_EMAIL=ops@shadesology.com

# ─── Payments (Stripe) ────────────────────────────────────────────────────────
PAYMENTS_MODE=sandbox       # sandbox | live; key must match selected mode
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
DEPOSIT_PERCENT=30          # order deposit collected now; remaining balance before dispatch
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ROUTING_NUMBER=

# ─── Tax Adapter ──────────────────────────────────────────────────────────────
TAX_PROVIDER=stripe_tax     # stripe_tax | taxjar
TAXJAR_API_KEY=

# ─── Shipping and carrier rates ───────────────────────────────────────────────
SHIPPO_API_TOKEN=
SHIPPO_CARRIER_NAME=
SHIPPING_ORIGIN_NAME=Shadesology
SHIPPING_ORIGIN_STREET1=
SHIPPING_ORIGIN_CITY=
SHIPPING_ORIGIN_STATE=
SHIPPING_ORIGIN_ZIP=
SHIPPING_ORIGIN_COUNTRY=US
SHIPPING_ORIGIN_PHONE=
SHIPPING_ORIGIN_EMAIL=
TAX_ORIGIN_STREET=
TAX_ORIGIN_CITY=
TAX_ORIGIN_STATE=
TAX_ORIGIN_ZIP=
TAX_ORIGIN_COUNTRY=US

# ─── Financing Provider ───────────────────────────────────────────────────────
FINANCING_PROVIDER=greensky  # Current hosted handoff adapter supports greensky only
FINANCING_MERCHANT_ID=
FINANCING_MODE=sandbox        # sandbox | live
# Obtain these endpoint URLs and query requirements directly from your lender.
# The backend adds merchant_id, reference_id, amount, and return_url parameters.
FINANCING_APPLICATION_URL_SANDBOX=
FINANCING_APPLICATION_URL_LIVE=
# Secret shared with the lender for HMAC-SHA256 callbacks; never expose to frontend.
FINANCING_WEBHOOK_SECRET=
# Representative estimates shown when no scheduled offer applies. Confirm the
# APR and exact disclosure with the lender before publishing.
FINANCING_REPRESENTATIVE_APR=12.99
FINANCING_REPRESENTATIVE_TERM_MONTHS=120
FINANCING_REPRESENTATIVE_DISCLOSURE=Estimated payment only; this is not a credit offer or commitment. Actual terms, eligibility, APR, and payment are determined by the lender after application.

# ─── Chat Provider ────────────────────────────────────────────────────────────
CHAT_PROVIDER=intercom       # intercom | zendesk | crisp | tawk
CHAT_APP_ID=
CHAT_API_KEY=
CHAT_BUSINESS_TIMEZONE=America/New_York
CHAT_BUSINESS_HOURS_NOTIFY_EMAIL=support@shadesology.com
CHAT_OFFLINE_NOTIFY_EMAIL=support@shadesology.com
LEADS_NOTIFY_EMAIL=support@shadesology.com

# ─── Frontend URL (used in emails and redirects) ──────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Internal API secret (backend-to-backend calls e.g. pricing engine) ───────
INTERNAL_API_SECRET=replace_with_a_long_random_secret

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Leave empty to use Redis-backed sliding window; falls back to in-memory if Redis unavailable
RATE_LIMIT_REDIS_URL=redis://localhost:6379

# ─── AWS IAM policy note ──────────────────────────────────────────────────────
# The IAM user / role needs EXACTLY these permissions (nothing broader):
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject  → arn:aws:s3:::shadesology-media-public/*
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:HeadObject  → arn:aws:s3:::shadesology-private-docs/*
#   ses:SendEmail, ses:SendRawEmail                              → arn:aws:ses:<region>:<account>:identity/*
# Use separate key pairs for dev and prod.
