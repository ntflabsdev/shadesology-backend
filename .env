# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://infofrems_db_user:wxMOfrPzhKCf80DM@cluster0.yfgsaa8.mongodb.net/shadesology
DB_NAME=shadesology

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d
COOKIE_SECRET=dev_cookie_secret_change_in_production

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_URL=redis://localhost:6379
# Set to false in local dev if Redis is not installed yet.
# Set to true (or remove this line) when Redis is running.
REDIS_ENABLED=false

# ─── AWS (shared credentials) ─────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── S3 public bucket (CMS media, product images) ─────────────────────────────
S3_BUCKET_PUBLIC=shadesology-media-public
S3_PUBLIC_BASE_URL=https://shadesology-media-public.s3.us-east-1.amazonaws.com
S3_SIGNED_URL_EXPIRES=3600

# ─── S3 private bucket (gated docs, quotes, customer uploads) ─────────────────
S3_BUCKET_PRIVATE=shadesology-private-docs

# ─── Amazon SES (transactional email only) ────────────────────────────────────
SES_FROM_EMAIL=noreply@shadesology.com
SES_REPLY_TO=support@shadesology.com
SES_CONFIGURATION_SET=shadesology-transactional
SES_MODE=sandbox
SES_ALERT_TO=dev@shadesology.com

# ─── HubSpot (CRM + marketing email only) ────────────────────────────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_MODE=sandbox
HUBSPOT_WEBHOOK_SECRET=

# ─── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace

# ─── Tax ──────────────────────────────────────────────────────────────────────
TAX_PROVIDER=stripe_tax
TAXJAR_API_KEY=

# ─── Financing ────────────────────────────────────────────────────────────────
FINANCING_PROVIDER=greensky
FINANCING_API_KEY=
FINANCING_MERCHANT_ID=
FINANCING_MODE=sandbox

# ─── Internal API secret ──────────────────────────────────────────────────────
INTERNAL_API_SECRET=dev_internal_secret_change_in_production

# ─── Frontend URL ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
